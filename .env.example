# --- Banco de dados ---
# Local (docker-compose up -d):
DATABASE_URL="postgres://postgres:postgres@localhost:5432/prospecta_crm"
# Produção (Neon -> Connect -> connection string do branch production):
# DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Sessão local assinada (gere um valor aleatório com pelo menos 32 caracteres).
AUTH_SESSION_SECRET="gere-um-segredo-aleatorio-com-32-caracteres-ou-mais"

# === AIOX Variables (added 2026-08-16) ===
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Get your key at: https://exa.ai/
EXA_API_KEY=
# Usually free, no key required for basic usage
CONTEXT7_API_KEY=
# Get from your Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=
# Get from: ClickUp Settings > Apps > API Token
CLICKUP_API_KEY=
# From your N8N instance settings
N8N_API_KEY=
N8N_WEBHOOK_URL=
# Sentry (error tracking)
SENTRY_DSN=
# Railway (deployment)
RAILWAY_TOKEN=
# Vercel (deployment)
VERCEL_TOKEN=
# --------------------------------------------
NODE_ENV=development
AIOX_VERSION=5.4.1
